includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 8
    phpVersion: 70400
    paths:
        - huella-verifactu.php
        - autoload.php
        - src
        - tests
    excludePaths:
        - tests/stubs
        - tests/e2e # WP-CLI scripts: the e2e CI job runs and checks them
        - tests/contract # WP-CLI script run by hand against a real cloud (README there)
    scanDirectories:
        - vendor-prefixed # chillerlan/php-qrcode under our namespace (Strauss); read, not analysed
    bootstrapFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
        - tests/stubs/wpo-ips.php
